# ==============================================
# Karma Services (Fastify & Worker) - Ortam Değişkenleri
# ==============================================

# PostgreSQL Veritabanı Bağlantısı
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# Web ve Services Arasındaki Güvenlik Anahtarı (Web .env ile aynı olmalı)
INTERNAL_API_KEY="your-internal-api-secret-key-matches-web"

# Redis Sunucu Bağlantısı (BullMQ Kuyrukları İçin)
# Örnek: redis://localhost:6379 veya redis://default:password@redis-host:6379
REDIS_URL="redis://localhost:6379"

# Sunucu Port ve Dinleme Adresi (Konteyner/Bulut ortamları için)
PORT=3001
HOST="0.0.0.0"

# Opsiyonel: Residential Proxy URL'i (WAF/Cloudflare ve IP engellerini aşmak için)
# Örnek: http://username:password@proxy-host:port
# PROXY_URL="http://user:pass@pr.example.com:7000"
