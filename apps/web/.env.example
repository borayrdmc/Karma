# ==========================================
# Karma Web (Next.js) - Ortam Değişkenleri
# ==========================================

# Better Auth Oturum Anahtarları
# Üretmek için: openssl rand -base64 32
BETTER_AUTH_SECRET="your-better-auth-secret-key-32-chars-minimum"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Resend E-Posta Servisi (Şifre Sıfırlama)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Karma <noreply@karmatakip.com>"

# Sentry Hata İzleme Servisi
NEXT_PUBLIC_SENTRY_DSN="https://your-dsn@ingest.de.sentry.io/project-id"

# PostgreSQL Veritabanı Bağlantısı (Supabase / Neon / Self-hosted)
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# Services (Fastify Backend) Sunucu Bağlantısı
SERVICES_URL="http://localhost:3001"

# Web ve Services Arasındaki Güvenlik Anahtarı (Her iki tarafta aynı olmalı)
INTERNAL_API_KEY="your-internal-api-secret-key-matches-services"

# Landing Page Canlı Demo Kartı Bilgileri (Opsiyonel)
DEMO_PRODUCT_ID="00000000-0000-0000-0000-000000000000"
DEMO_PRODUCT_NAME="Örnek Ürün Adı"
DEMO_PRODUCT_BRAND="Örnek Marka"
